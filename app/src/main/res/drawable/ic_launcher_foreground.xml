    android:viewportHeight="108">

    <!-- GNSS / RTK signal -->
    <path android:pathData="M49.8,33.2 A6,6 0 0,1 58.2,33.2" android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2" android:strokeLineCap="round" />
